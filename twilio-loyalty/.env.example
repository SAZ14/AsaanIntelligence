# Copy to .env. twilio-run loads these as `context.*` in the functions.
# ACCOUNT_SID / AUTH_TOKEN come from your Twilio Console.
ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AUTH_TOKEN=your_auth_token

# The Sync service that stores the stamp cards. Create one:
#   twilio api:sync:v1:services:create --friendly-name loyalty
# then paste its SID (ISxxxx...) here.
SYNC_SERVICE_SID=ISxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# All venues, as a JSON array on ONE line. Each needs id, name,
# whatsapp_number, stamps_required, reward. For win-back also add
# winback_template_sid (+ optional inactive_days, min_scans, nudge_cooldown_days).
RESTAURANTS=[{"id":"sugar_rush","name":"Sugar Rush","whatsapp_number":"+14155238886","stamps_required":5,"reward":"a free ice cream","winback_template_sid":"HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx","inactive_days":7,"min_scans":3,"nudge_cooldown_days":7}]
