# Copy to .env and fill in. .env is gitignored.

# ── Anthropic (Reputation agent) ──
ANTHROPIC_API_KEY=sk-ant-...

# ── Twilio WhatsApp (active live delivery backend) ──
# From the Twilio console. For the sandbox: Messaging → Try it out → WhatsApp.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The sandbox/sender 'from' number, e.g. +14155238886 (Twilio's sandbox number).
TWILIO_WHATSAPP_NUMBER=
# Validate Twilio's X-Twilio-Signature on the inbound webhook (recommended in prod).
# TWILIO_VALIDATE_SIGNATURE=false

# Owner's WhatsApp number, international format (e.g. 923001234567 or +923001234567).
OWNER_NUMBER=

# Print request params instead of sending. Set to false to actually send.
DRY_RUN=true

# ── WhatsApp Cloud API (Meta) — alternative backend, optional ──
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TOKEN=
# WHATSAPP_VERIFY_TOKEN=change-me-to-a-random-string
# WHATSAPP_GRAPH_VERSION=v21.0
