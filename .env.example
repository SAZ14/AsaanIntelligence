# Copy this to `.env` and fill in real values. These are SHARED across all venues.
# (Never commit the real .env — it's gitignored.)

# ── Twilio (one account sends to all owners) ──
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Twilio WhatsApp sender. Sandbox number for testing, or your approved business number.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Optional: default recipient if a venue has no owner_whatsapp in venues.toml.
# Normally you set the recipient per-venue in venues.toml instead.
OWNER_WHATSAPP_TO=whatsapp:+923001234567

# ── Optional: LLM reorder briefing (only if you enable it) ──
# ANTHROPIC_API_KEY=sk-ant-...
