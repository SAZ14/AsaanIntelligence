# Copy to .env and fill in. .env is gitignored.

# ── Anthropic (Reputation agent) ──
ANTHROPIC_API_KEY=sk-ant-...

# ── WhatsApp Cloud API (Meta) ──
# From the Meta App dashboard → WhatsApp → API Setup.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
# You invent this string; paste the SAME value into the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=change-me-to-a-random-string
# Optional: pin the Graph API version (default v21.0).
# WHATSAPP_GRAPH_VERSION=v21.0

# Owner's WhatsApp number in international format, no '+' (e.g. 923001234567).
OWNER_NUMBER=

# Print payloads instead of calling Meta. Set to false to actually send.
DRY_RUN=true
