# Twilio WhatsApp (required for live agent + message delivery)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Venue
ASAAN_VENUE_NAME=Sugar Rush
ASAAN_VENUE_SLUG=sugar-rush

# Public URL where Twilio can POST inbound WhatsApp messages
# Twilio Console → WhatsApp Sender → "When a message comes in" → https://your-domain.com/webhooks/twilio/whatsapp
ASAAN_PUBLIC_BASE_URL=https://your-domain.com

# Reject inbound webhooks whose X-Twilio-Signature doesn't validate (recommended in
# production). Requires TWILIO_AUTH_TOKEN and a correct ASAAN_PUBLIC_BASE_URL. Off by default.
# ASAAN_VALIDATE_TWILIO_SIGNATURE=1

# Legacy web join page (optional fallback)
ASAAN_JOIN_BASE_URL=https://your-domain.com

# Optional paths
# ASAAN_DATA_DIR=./data
# ASAAN_OUTBOX_DIR=./output
