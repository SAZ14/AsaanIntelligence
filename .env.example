# Copy to .env and fill in. .env is gitignored.

# ── Anthropic (Reputation agent) ──
ANTHROPIC_API_KEY=sk-ant-...

# ── Twilio WhatsApp (active live delivery backend) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# TWILIO_VALIDATE_SIGNATURE=false

OWNER_NUMBER=
DRY_RUN=true

# ── Review sources ──

# Google Maps (via Apify compass/crawler-google-places)
GOOGLE_MAPS_TERMS=["Your Cafe"]
GOOGLE_MAPS_LOCATION=Islamabad

# FoodPanda (via Apify)
APIFY_API_KEY=
FOODPANDA_URL=https://www.foodpanda.pk/restaurants/new?lng=73.036273&lat=33.700483
FOODPANDA_KEYWORD=

# Instagram (via Apify)
INSTAGRAM_USERNAMES=["your_cafe"]
