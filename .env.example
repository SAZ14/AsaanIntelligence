# Copy to .env and fill in. .env is gitignored.

# ── Anthropic & LLM Configuration ──
ANTHROPIC_API_KEY=sk-ant-...

# ── Supabase Production Database ──
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Twilio WhatsApp (active live delivery backend) ──
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_WHATSAPP_CUSTOMER_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_MERCHANT_FROM=whatsapp:+14155238887
# TWILIO_VALIDATE_SIGNATURE=false

# ── Owner Configuration ──
OWNER_NUMBER=
ASAAN_OWNER_PHONES=+923001234567
DRY_RUN=true

# ── Review Scraper Configuration (Apify) ──
APIFY_API_KEY=
GOOGLE_MAPS_TERMS=["Your Cafe"]
GOOGLE_MAPS_LOCATION=Islamabad
FOODPANDA_URL=https://www.foodpanda.pk/restaurants/new?lng=73.036273&lat=33.700483
FOODPANDA_KEYWORD=
INSTAGRAM_USERNAMES=["your_cafe"]

# ── Optional paths ──
# ASAAN_DATA_DIR=./data
# ASAAN_OUTBOX_DIR=./output
