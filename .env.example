# Twilio WhatsApp (required for live message delivery)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Venue / join page
ASAAN_VENUE_NAME=Sugar Rush
ASAAN_VENUE_SLUG=sugar-rush
ASAAN_JOIN_BASE_URL=https://your-domain.com

# Optional paths
# ASAAN_DATA_DIR=./data
# ASAAN_OUTBOX_DIR=./output
