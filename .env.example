# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Anthropic (used by the reputation agent, not by WhatsApp sends)
ANTHROPIC_API_KEY=

# Twilio credentials (Console > Account)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=

# WhatsApp sender. The sandbox sender is whatsapp:+14155238886 — recipients must
# first join the sandbox. Use your registered production sender for live use.
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Owner / recipient number in E.164 with the whatsapp: prefix
OWNER_NUMBER=whatsapp:+1XXXXXXXXXX

# 1 = build the message but do not send; 0 = actually send
DRY_RUN=1
