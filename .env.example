# Copy to .env and fill in. The .env file is gitignored.

# Which venues exist + their rewards (one JSON file; see data/restaurants.example.json).
RESTAURANTS_CONFIG=restaurants.json

# Where the SQLite loyalty database lives. In production point this at a
# persistent disk (e.g. /data/loyalty.db) so stamp counts survive restarts.
LOYALTY_DB=loyalty.db

# ── Single-restaurant fallback (only used when RESTAURANTS_CONFIG is absent) ──
VENUE_ID=default
VENUE_NAME=Sugar Rush
WHATSAPP_FROM=whatsapp:+14155238886

# ── Outbound sending (NOT needed by the webhook) ──
# The webhook replies via TwiML and needs none of these.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# WhatsApp outbound (optional scripts only)
WHATSAPP_DRY_RUN=1

# SMS — used for the proactive "we miss you" / event-invite nudges. SMS avoids
# Meta verification + templates entirely. SMS_FROM is a Twilio SMS number.
SMS_DRY_RUN=1
SMS_FROM=+10000000000
